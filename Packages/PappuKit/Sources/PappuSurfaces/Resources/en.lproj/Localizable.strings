/* The bar's own accessibility label (BAR-14). */
"bar.accessibility.label" = "PappuClip actions";

/* Announced when the bar appears (BAR-14). */
"bar.accessibility.appeared" = "PappuClip actions available";

/* Takes back a running action (BAR-12a, RUN-3). */
"bar.cancel" = "Cancel";

/* An action is running (BAR-12a). */
"bar.feedback.running" = "Working";

/* The Copy confirmation (BAR-12a). */
"bar.feedback.copied" = "Copied";

/* Announced when an action's result is shown in the bar (BAR-12b). %@ is the result. */
"bar.feedback.result" = "Result: %@";

/* An action finished (BAR-12a). */
"bar.feedback.succeeded" = "Done";

/* An action failed (BAR-12a). */
"bar.feedback.failed" = "The action did not finish";

/* %1$@ is the action's name, %2$@ is why it cannot be run. */
"bar.tooltip.disabled" = "%1$@ — %2$@";

/* Offered when the selected text is an extension (EXM-2). %@ is the extension's name. */
"bar.install" = "Install Extension \U201C%@\U201D";

/* The same offer when the selected extension cannot be installed (EXM-2). */
"bar.install.unnamed" = "Install Extension";

/* Why a selected extension cannot be installed (EXM-2). */
"bar.install.tooLong" = "The selection is longer than 5,000 characters, the most an extension can be installed from";

/* Why a selected extension cannot be installed. %@ is the reason. */
"bar.install.unreadable" = "It could not be read: %@";
