<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The whole list, on purpose. No network, no files, and no com.apple.security.cs.allow-jit:
	     spike 5 measures JavaScriptCore as the product's helper would run it (architecture §10.1). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
