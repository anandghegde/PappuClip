<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>PappuClip</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- EXM-1: extension files open in the app, which shows the install review. PappuClip owns its own
	     types; PopClip's are claimed as an alternate, so a Mac with PopClip keeps opening them there by
	     default. ProductIdentity.FileExtension lists the same suffixes. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PappuClip Extension</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.pappuclip.extension</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>pappuext</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PappuClip Extension Archive or Snippet</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.pappuclip.extension.zipped</string>
				<string>app.pappuclip.extension.text</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>pappuextz</string>
				<string>pappucliptxt</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PopClip Extension</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.pilotmoon.popclip.extension</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>popclipext</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PopClip Extension Archive or Snippet</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.pilotmoon.popclip.extension.zipped</string>
				<string>com.pilotmoon.popclip.extension.text</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>popclipextz</string>
				<string>popcliptxt</string>
			</array>
		</dict>
		<!-- EXM-3: a snippet saved as code or YAML. Listed in Open With and nothing more; each file is
		     read as snippet text, so one with no marker is refused. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Snippet as Code or YAML</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>js</string>
				<string>ts</string>
				<string>yaml</string>
			</array>
		</dict>
	</array>
	<!-- EXM-4: the types behind the document types above. PappuClip exports only its own. PopClip's
	     are imported, never exported, and declared exactly as PopClip exports them, so the app that
	     owns them stays their owner and PappuClip stays an alternate handler: listed under Open With,
	     never the default. .popclipconfig and .popcliplicense are PopClip's own and not claimed. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.pappuclip.extension</string>
			<key>UTTypeDescription</key>
			<string>PappuClip Extension Package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
				<string>public.directory</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pappuext</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.pappuclip.extension.zipped</string>
			<key>UTTypeDescription</key>
			<string>PappuClip Extension</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pappuextz</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.pappuclip.extension.text</string>
			<key>UTTypeDescription</key>
			<string>PappuClip Extension Text File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pappucliptxt</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.pilotmoon.popclip.extension</string>
			<key>UTTypeDescription</key>
			<string>PopClip Extension Package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.directory</string>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>popclipext</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.pilotmoon.popclip.extension.zipped</string>
			<key>UTTypeDescription</key>
			<string>PopClip Extension</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>popclipextz</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.pilotmoon.popclip.extension.text</string>
			<key>UTTypeDescription</key>
			<string>PopClip Extension Text File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>popcliptxt</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- PRD §12: an agent app. No Dock icon, no menu bar; the status item is the whole of the UI. -->
	<key>LSUIElement</key>
	<true/>
	<!-- ONB-5. PappuClipRunner.xpc sends the events, but the app is the responsible process, so this
	     is the string macOS shows when an extension's AppleScript first talks to another app. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Extensions you install can run AppleScripts that control other apps. macOS asks once for each app.</string>
	<!-- Every window is made in code, so there is no main storyboard and no nib to name. -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- DIA-3, DIA-4. The channel decides whether beta diagnostics are offered (release, beta or
	     development; empty is development). The two URLs are PLACEHOLDERS in the .invalid domain,
	     which never resolves (RFC 2606): no report leaves the Mac until they name the real service. -->
	<key>PappuReleaseChannel</key>
	<string>$(PAPPU_RELEASE_CHANNEL)</string>
	<key>PappuCrashReportURL</key>
	<string>https://diagnostics.pappuclip.invalid/v1/crash-reports</string>
	<key>PappuDiagnosticsURL</key>
	<string>https://diagnostics.pappuclip.invalid/v1/beta-diagnostics</string>
</dict>
</plist>
